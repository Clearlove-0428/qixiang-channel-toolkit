# Documentation only: environment variables are read from the process.
# This file is NOT automatically loaded. Set variables in PowerShell or your shell.
# QIXIANG_DATA_ROOT=/absolute/path/to/local-data
# QIXIANG_BROWSER_PROFILE=/absolute/path/to/private-browser-profile
# QIXIANG_BROWSER_CHANNEL=chrome
# Optional Qwen-compatible GGUF model and llama.cpp server; no weights are bundled.
# QIXIANG_MODEL_PATH=/absolute/path/to/model.gguf
# QIXIANG_LLAMA_SERVER=/absolute/path/to/llama-server.exe
# QIXIANG_MODEL_GPU_LAYERS=0
# QIXIANG_MODEL_DEVICE=Vulkan0
